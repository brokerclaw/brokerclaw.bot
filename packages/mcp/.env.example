# BrokerClaw MCP Server — Environment Variables
# Copy this file to .env and fill in your values.

# Hex-encoded private key for signing transactions (required for write operations)
BROKER_PRIVATE_KEY=

# Custom RPC endpoint (defaults to https://mainnet.base.org)
BROKER_RPC_URL=https://mainnet.base.org

# Chain selection: "mainnet" or "testnet" (defaults to "mainnet")
BROKER_CHAIN=mainnet

# HTTP server port (defaults to 3001, only used in HTTP transport mode)
PORT=3001
