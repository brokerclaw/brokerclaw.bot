# BrokerClaw Contracts — Environment Variables
# Copy this file to .env and fill in your values.
# Used by Foundry for deployment scripts and verification.

# RPC endpoint for Base mainnet (used in foundry.toml [rpc_endpoints])
BASE_RPC_URL=https://mainnet.base.org

# Private key for the deployer account (hex-encoded, no 0x prefix or with)
# Used by Deploy.s.sol via vm.envUint("DEPLOYER_PRIVATE_KEY")
DEPLOYER_PRIVATE_KEY=

# Treasury address to receive protocol fees
TREASURY_ADDRESS=

# (Optional) BROKR token address — set if deploying with an existing token
# If omitted, Deploy.s.sol defaults to address(0)
BROKER_TOKEN_ADDRESS=

# BaseScan API key for contract verification (used in foundry.toml [etherscan])
BASESCAN_API_KEY=
