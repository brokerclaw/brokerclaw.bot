# BrokerClaw Web Frontend — Environment Variables
# Copy this file to .env and fill in your values.
#
# Note: The frontend currently hardcodes contract addresses and chain config
# in src/lib/contracts/addresses.ts and src/lib/contracts/config.ts.
# No environment variables are required to run the dev server.
#
# If you add SvelteKit public env vars in the future, prefix them with PUBLIC_
# so they are available client-side (see: https://svelte.dev/docs/kit/$env-static-public).

# (Reserved for future use)
# PUBLIC_RPC_URL=https://mainnet.base.org
# PUBLIC_CHAIN_ID=8453
