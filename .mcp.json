{
  "mcpServers": {
    "svelte": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sveltejs/mcp"
      ],
      "env": {}
    },
    "brokers-bot": {
      "type": "sse",
      "url": "http://localhost:3001/sse"
    },
    "buffer": {
      "type": "http",
      "url": "https://mcp.buffer.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BUFFER_ACCESS_TOKEN}"
      }
    }
  }
}
